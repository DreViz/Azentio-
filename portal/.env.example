# Postgres connection for the schema owner. User requests switch to the restricted portal_app role.
DATABASE_URL=postgres://postgres:postgres@localhost:54329/portal
# Demo mode shows sign-in codes on screen for seeded personas (judging convenience, labelled in the UI).
DEMO_MODE=true
# Optional: real email delivery of sign-in codes.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Optional: Anthropic-compatible model API (Claude, DeepSeek, ...) for AIRA, moderation copilot and theme suggestions. Without it, deterministic fallbacks run.
ANTHROPIC_API_KEY=
# Any Anthropic-compatible /v1/messages endpoint. DeepSeek example:
#   ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic
#   AI_MODEL=deepseek-flash
#   AI_FAST_MODEL=deepseek-flash
ANTHROPIC_BASE_URL=
AI_MODEL=claude-sonnet-5
AI_FAST_MODEL=claude-haiku-4-5-20251001
